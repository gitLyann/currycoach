# Salin menjadi .env atau atur sebagai environment variables pada server.
APP_ENV=development
SECRET_KEY=GANTI_DENGAN_SECRET_ACAK_MINIMAL_32_KARAKTER
ADMIN_KEY=GANTI_DENGAN_KUNCI_ADMIN_ACAK_YANG_KUAT
DATABASE=instance/currycoach.sqlite3
THRESHOLD=0.45
SESSION_COOKIE_SECURE=0
FLASK_DEBUG=0

# Telegram Bot (buat bot melalui BotFather; jangan commit token asli)
TELEGRAM_BOT_TOKEN=ISI_TOKEN_BOT_TELEGRAM
# URL backend Flask yang dapat dijangkau proses bot
CURRYCOACH_API_URL=http://127.0.0.1:5000
